{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "AllowCloudFrontOACRead", "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::auraautomation.site/*",
      "Condition": { "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::<AWS_ACCOUNT_ID>:distribution/<PROD_DISTRIBUTION_ID>" } } },
    { "Sid": "DenyInsecureTransport", "Effect": "Deny", "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::auraautomation.site","arn:aws:s3:::auraautomation.site/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } } }
  ]
}
