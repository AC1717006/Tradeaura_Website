{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ListTargetBuckets", "Effect": "Allow",
      "Action": ["s3:ListBucket","s3:GetBucketVersioning","s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::auraautomation.site",
        "arn:aws:s3:::staging.auraautomation.site",
        "arn:aws:s3:::auraautomation-backup"
      ] },
    { "Sid": "WriteObjects", "Effect": "Allow",
      "Action": ["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:PutObjectAcl"],
      "Resource": [
        "arn:aws:s3:::auraautomation.site/*",
        "arn:aws:s3:::staging.auraautomation.site/*",
        "arn:aws:s3:::auraautomation-backup/*"
      ] },
    { "Sid": "DenyWritingSecrets", "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::auraautomation.site/.env*",
        "arn:aws:s3:::auraautomation.site/*.pem",
        "arn:aws:s3:::auraautomation.site/*.key",
        "arn:aws:s3:::auraautomation.site/package*.json",
        "arn:aws:s3:::auraautomation.site/scripts/*",
        "arn:aws:s3:::auraautomation.site/api/*",
        "arn:aws:s3:::auraautomation.site/server/*",
        "arn:aws:s3:::auraautomation.site/.github/*",
        "arn:aws:s3:::staging.auraautomation.site/.env*",
        "arn:aws:s3:::staging.auraautomation.site/scripts/*"
      ] },
    { "Sid": "Invalidate", "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation","cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::<AWS_ACCOUNT_ID>:distribution/*" }
  ]
}
