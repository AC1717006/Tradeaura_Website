# ─────────────────────────────────────────────
# TradeAura — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── AI Rewriting (Required) ───────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── News Sources (at least one required) ──────
# Currents API — https://currentsapi.services/
# Free: 600 req/hour
CURRENTS_API_KEY=

# NewsData.io — https://newsdata.io/
# Free: 200 req/day | Use country=in for India news
NEWSDATA_API_KEY=

# NewsAPI.org — https://newsapi.org/ (reserved, not active in pipeline)
NEWS_API_KEY=

# ── AWS S3 Deployment (GitHub Secrets only) ───
# Set these in GitHub → Settings → Secrets → Actions
# Do NOT put real values here
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Legacy (not used in current pipeline) ─────
GEMINI_API_KEY=

# ─────────────────────────────────────────────
# AI SALES CHAT ASSISTANT  (/api/chat)
# The endpoint is FAIL-CLOSED: without GEMINI_API_KEY it stays
# mounted, reports "not_configured" and refuses to call out.
# ─────────────────────────────────────────────

# ── Gemini (REQUIRED to switch the assistant on) ──
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Lead forwarding to the EXISTING Google Sheet ──
# Same Apps Script /exec URL the website contact form already posts to.
# Optional: without it, leads are still written to data/chat/leads.jsonl.
LEAD_WEBHOOK_URL=

# ── WhatsApp Cloud API — internal "new lead" alert ──
# TradeAura's OWN credentials. Do NOT reuse another project's WABA.
# NOTE: a business-initiated message needs an APPROVED Meta template.
# Leave WHATSAPP_TEMPLATE_NAME blank only if the recipient has messaged
# the business within the last 24 hours.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_NUMBERS=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ── Public, NOT secret — already printed on every page ──
PUBLIC_WHATSAPP_NUMBER=919587402524

# ── Limits (optional; sensible defaults in server/lib/config.js) ──
CHAT_ALLOWED_ORIGINS=https://www.auraautomation.site,https://auraautomation.site,https://staging.auraautomation.site
CHAT_RATE_MAX=30
CHAT_RATE_WINDOW_MS=600000
CHAT_MAX_TURNS=40
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_DATA_DIR=/home/ubuntu/tradeaura-api/data/chat

# ─────────────────────────────────────────────
# POSTGRESQL — source of truth for AI chat leads
# Shares the instance with the live trading system, so the pool is small
# and every query is time-bounded. Role has NO privileges on algotrading.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://tradeaura_app:<password>@127.0.0.1:5432/tradeaura
PGPOOL_MAX=4
PGPOOL_IDLE_MS=30000
PG_CONNECT_TIMEOUT_MS=4000
PG_STATEMENT_TIMEOUT=5000

# ── Admin platform (added 2026-09-03) ────────────────────────────────────
# Cookie is Secure by default; set to false ONLY for a local http test instance.
ADMIN_COOKIE_SECURE=true
# Optional: stable HMAC key for hashing client IPs in audit/session rows. If unset a
# per-boot random key is used (hashes then change on every restart). 32+ random hex chars.
ADMIN_HASH_SECRET=
# Google Analytics 4 + Search Console (server-side only; leave blank until configured)
GOOGLE_SERVICE_ACCOUNT_FILE=/home/ubuntu/tradeaura-api/secrets/google-sa.json
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:auraautomation.site
# Analytics retention. Purge is OFF unless explicitly enabled; rollups always run.
ANALYTICS_RETENTION_ENABLED=false
ANALYTICS_RAW_RETENTION_DAYS=180
ANALYTICS_SESSION_RETENTION_DAYS=400
CHAT_CONVERSATION_RETENTION_DAYS=180
OPS_EVENTS_RETENTION_DAYS=30
ADMIN_AUDIT_RETENTION_DAYS=400
# The repo-root static server (old site) is OFF in production. Never enable on the API host.
SERVE_LEGACY_SITE=false
