# ─────────────────────────────────────────────
# TradeAura — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── AI Rewriting (Required) ───────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── News Sources (at least one required) ──────
# Currents API — https://currentsapi.services/
# Free: 600 req/hour
CURRENTS_API_KEY=

# NewsData.io — https://newsdata.io/
# Free: 200 req/day | Use country=in for India news
NEWSDATA_API_KEY=

# NewsAPI.org — https://newsapi.org/ (reserved, not active in pipeline)
NEWS_API_KEY=

# ── AWS S3 Deployment (GitHub Secrets only) ───
# Set these in GitHub → Settings → Secrets → Actions
# Do NOT put real values here
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Legacy (not used in current pipeline) ─────
GEMINI_API_KEY=
